{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://valuextract.io/schemas/agri-opportunity-report-v1.json",
  "title": "ValueXtract Agri Opportunity Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "client",
    "analysis_scope",
    "agri_business_insights",
    "opportunities",
    "top_priorities",
    "additional_information_requested",
    "basis_and_limitations"
  ],
  "properties": {
    "client": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "industry", "period", "document_type", "currency"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "industry": {"type": "string", "minLength": 1},
        "period": {"type": "string", "minLength": 1},
        "document_type": {"type": "string", "minLength": 1},
        "currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
        "report_date": {"type": ["string", "null"]}
      }
    },
    "analysis_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["documents", "entities", "periods", "scope_note"],
      "properties": {
        "documents": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "entities": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "periods": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "scope_note": {"type": "string"}
      }
    },
    "agri_business_insights": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {"type": "string", "minLength": 1}
    },
    "opportunities": {
      "type": "array",
      "items": {"$ref": "#/$defs/opportunity"}
    },
    "top_priorities": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["trigger_id", "reason"],
        "properties": {
          "trigger_id": {"type": "string", "minLength": 1},
          "reason": {"type": "string", "minLength": 1}
        }
      }
    },
    "additional_information_requested": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["item", "why"],
        "properties": {
          "item": {"type": "string", "minLength": 1},
          "why": {"type": "string", "minLength": 1},
          "related_trigger_id": {"type": ["string", "null"]}
        }
      }
    },
    "basis_and_limitations": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    }
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_type",
        "description",
        "financial_period",
        "source_document",
        "source_section",
        "source_page"
      ],
      "properties": {
        "evidence_type": {
          "type": "string",
          "enum": ["Fact", "Calculation", "Inference"]
        },
        "description": {"type": "string", "minLength": 1},
        "financial_period": {"type": "string", "minLength": 1},
        "source_document": {"type": "string", "minLength": 1},
        "source_section": {"type": "string", "minLength": 1},
        "source_page": {"type": ["integer", "string", "null"]}
      }
    },
    "calculation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["basis", "formula", "assumptions"],
      "properties": {
        "basis": {"type": "string", "minLength": 1},
        "formula": {"type": "string", "minLength": 1},
        "assumptions": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "engagement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["duration", "resources", "timeline", "pricing"],
      "properties": {
        "duration": {"type": "string", "minLength": 1},
        "resources": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "timeline": {
          "type": "string",
          "enum": ["Quick (0-3 months)", "Medium (3-9 months)", "Strategic (9+ months)"]
        },
        "pricing": {
          "type": "string",
          "enum": ["Fixed Fee", "Monthly Retainer", "Success Fee", "Project Fee", "Recurring Fee", "Transaction Percentage", "Hybrid"]
        }
      }
    },
    "opportunity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "trigger_id",
        "opportunity_name",
        "service_line",
        "agri_category",
        "financial_evidence",
        "finding",
        "why_this_matters",
        "how_we_can_assist",
        "recommended_solution",
        "engagement_details",
        "value_proposition",
        "calculation",
        "client_value_low",
        "client_value_high",
        "value_type",
        "fee_low",
        "fee_high",
        "roi",
        "priority",
        "timeline",
        "confidence"
      ],
      "properties": {
        "trigger_id": {"type": "string", "pattern": "^[A-Za-z0-9_-]+$"},
        "opportunity_name": {"type": "string", "minLength": 1},
        "service_line": {"type": "string", "minLength": 1},
        "agri_category": {"type": "string", "minLength": 1},
        "financial_evidence": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/evidence"}
        },
        "finding": {"type": "string", "minLength": 1},
        "why_this_matters": {"type": "string", "minLength": 1},
        "how_we_can_assist": {"type": "string", "minLength": 1},
        "recommended_solution": {"type": "string", "minLength": 1},
        "engagement_details": {"$ref": "#/$defs/engagement"},
        "value_proposition": {"type": "string", "minLength": 1},
        "calculation": {"$ref": "#/$defs/calculation"},
        "client_value_low": {"type": "number", "exclusiveMinimum": 0},
        "client_value_high": {"type": "number", "exclusiveMinimum": 0},
        "value_type": {
          "type": "string",
          "enum": ["Recurring annual value", "Once-off value", "Cash release", "Capital enabled", "Risk-adjusted value", "Mixed value"]
        },
        "fee_low": {"type": "number", "exclusiveMinimum": 0},
        "fee_high": {"type": "number", "exclusiveMinimum": 0},
        "roi": {"type": "number", "exclusiveMinimum": 0},
        "priority": {"type": "string", "enum": ["HIGH", "MEDIUM", "LOW"]},
        "timeline": {
          "type": "string",
          "enum": ["Quick (0-3 months)", "Medium (3-9 months)", "Strategic (9+ months)"]
        },
        "confidence": {"type": "string", "enum": ["High", "Medium", "Low"]}
      }
    }
  }
}
